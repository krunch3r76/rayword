# Ignore all input and output directories anywhere in the project
**/input/*
**/output/*

# Keep directory structure with .gitkeep files
!**/input/.gitkeep
!**/output/.gitkeep

# Byte-compiled / optimized files
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environment
venv/
env/
*.env

# Logs and databases
*.log
*.sqlite
data/*.db

# Compiled Python files
*.pyc

# Other generated files
*.swp
*.swo
*.tmp
.DS_Store

# vim backups
*~
